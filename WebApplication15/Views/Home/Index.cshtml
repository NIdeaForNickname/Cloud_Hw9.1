@model IEnumerable<WebApplication15.Models.UserViewModel>

@{
    ViewData["Title"] = "Main";
}

<div class="text-center mb-5">
    <h1 class="display-4">People list</h1>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var user in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <div class="text-center pt-4">
                    <img src="@user.AvatarUrl" class="rounded-circle shadow" width="100" height="100" style="object-fit: cover;" alt="Avatar" />
                </div>
                <div class="card-body text-center">
                    <h5 class="card-title fw-bold">@user.Nickname</h5>
                    <p class="text-muted fst-italic">"@user.Status"</p>
                    <hr />
                    <ul class="list-unstyled text-start small ps-3">
                        <li><strong>Birth date:</strong> @user.BirthDate.ToString("dd.MM.yyyy")</li>
                        <li><strong>Registration:</strong> @user.RegistrationDate.ToString("dd.MM.yyyy")</li>
                        <li><strong>Last seen:</strong> @user.LastLoginDate.ToString("dd.MM.yyyy HH:mm")</li>
                    </ul>
                </div>
            </div>
        </div>
    }
</div>